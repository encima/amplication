{
  "name": "goto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode",
    "build": "tsc --noEmit && vite build --mode",
    "typecheck": "tsc --noEmit",
    "db:push": "tsx scripts/db-push.ts",
    "teardown": "tsx scripts/teardown.ts",
