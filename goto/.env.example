# Copy to .env.<target>.local, e.g. .env.multigres.local, .env.normal.local or .env.localstack.local.
# The Vite mode / test target name picks the file.

# Browser (exposed to the app)
VITE_SUPABASE_URL=https://<ref>.supabase.red
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only (tests and scripts)
SUPABASE_SECRET_KEY=sb_secret_...
# Multigres: ...?sslmode=require&sslnegotiation=direct
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.red:5432/postgres

# OAuth credentials, read by `supabase config push` and `supabase start`
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
