# Multigres project
MULTIGRES_URL=https://<ref>.supabase.red
MULTIGRES_PUBLISHABLE_KEY=sb_publishable_...
MULTIGRES_SECRET_KEY=sb_secret_...
MULTIGRES_DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.red:5432/postgres?sslmode=require&sslnegotiation=direct

# Normal (vanilla Postgres) project
NORMAL_URL=https://<ref>.supabase.red
NORMAL_PUBLISHABLE_KEY=sb_publishable_...
NORMAL_SECRET_KEY=sb_secret_...
NORMAL_DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.red:5432/postgres

# Postgres driver used by Drizzle: postgres-js | node-postgres
PG_DRIVER=postgres-js
